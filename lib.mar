extern "https://cdn.daymare.net/margarine/0.1.0/arm64-apple-darwin/libmargarine_rt.a";

mod ffi {
    extern {
        fn print_raw(val: Any)
        fn "margarinePanic" panic(msg: str): !

        fn int_to_str(value: int): str
        fn float_to_str(value: float): str
    }
}

use iter::Iter;


struct AnyInner {
    destroy_fn: fn(Ptr<()>),
    buffer: Ptr<()>,
}


struct Any {
    inner: Rc<AnyInner>,
    ty: int,
}


impl Destroy for AnyInner {
    fn destroy(self) {
        (self.destroy_fn)(self.buffer);
    }
}


impl Any {
    fn new<T>(val: T): Any {
        var buf = $ptr_alloc::<T>(1);
        $ptr_write_uninit(buf, val);
        var casted = $ptr_cast::<T, ()>(buf);
        var inner_val = AnyInner {
            destroy_fn: |ptr| {
                var typed = $ptr_cast::<(), T>(ptr);
                $ptr_drop(typed);
                $ptr_free(typed, 1);
            },
            buffer: casted,
        };
        Any {
            inner: $rc(inner_val),
            ty: $type_id::<T>(),
        }
    }


    fn downcast<T>(self): Option<T> {
        if self.ty == $type_id::<T>() {
            var inner = $rc_get(self.inner);
            var ptr = $ptr_cast::<(), T>(inner.buffer);
            some($ptr_read(ptr))
        } else {
            none()
        }
    }
}


fn print<T>(val: T) {
    ffi::print_raw(Any::new(val));
}


fn println<T>(val: T) {
    print(val);
    print("\n");
}


fn type_id_of<T>(val: T): int {
    $type_id::<T>()
}


fn panic(msg: str) : ! {
    ffi::panic(msg)
}

fn assert(value: bool, msg: str) {
    if !value { panic(msg) }
}


impl Range {
    fn __next__(self): Option<int> {
        if self.min < self.max {
            self.min += 1;
            some(self.min-1)
        } else {
            none()
        }

    }


    fn iter(self): Iter<int> {
        Iter {
            next: || self.__next__()
        }
    }


    fn contains(self, num: int): bool {
        self.min <= num && num < self.max
    }


    fn len(self): int {
        self.max - self.min
    }
}


struct Box<T> { value: T }


impl<T> Box<T> {
    fn new(value: T): Box<T> { Box { value } }
}



impl int {
    fn abs(self): int {
        var mask = self >> 63;
        (self ^ mask) - mask
    }


    fn to_str(self): str {
        ffi::int_to_str(self)
    }


    fn max(self, oth: int): int {
        if self > oth { self }
        else { oth }
    }


    fn min(self, oth: int): int {
        if self < oth { self }
        else { oth }
    }


    fn pow(self, exp: int): int {
        var count = 1;
        for _ in 0..exp {
            count *= self;
        }
        count
    }

}


impl float {
    fn to_str(self): str {
        ffi::float_to_str(self)
    }
}


impl<T> Option<T> {
    fn map<A>(self, f: fn(T): A): Option<A> {
        match self {
            some: val => {
                some(f(val))
            },

            none => {
                none()
            }
        }
    }


    fn is_some(self): bool {
        match self {
            some => true,
            none => false,
        }
    }
}


impl Eq for int {
    fn eq(self, oth: Self): bool {
        self == oth
    }
}

impl Eq for float {
    fn eq(self, oth: Self): bool {
        self == oth
    }
}

impl Eq for bool {
    fn eq(self, oth: Self): bool {
        self == oth
    }
}

impl Eq for () {
    fn eq(self, oth: Self): bool {
        self == oth
    }
}

