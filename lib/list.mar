//    }


    fn iter(self): ListIterator<T> {
        ListIterator {
            idx: 0,
            list: self,
        }
    }
}



struct ListIterator<T> {
    idx: int,
    list: [T]
}


impl<T> ListIterator<T> {
    fn __next__(&self): Option<T> {
        if self.idx < self.list.len() {
            self.idx += 1;
            some(self.list[self.idx - 1])
        } else {
            none()
        }
    }
}

